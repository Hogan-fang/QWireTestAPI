{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checker-definition.schema.json",
  "title": "CheckerDefinition",
  "description": "Metadata contract for a checker implementation that can be registered, discovered, and invoked by the checker framework.",
  "type": "object",
  "required": [
    "name",
    "category",
    "type",
    "description",
    "supportedCheckNodes"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Primary checker name used in check definitions and registry lookup."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": [],
      "description": "Alternative names accepted by the dispatcher."
    },
    "category": {
      "type": "string",
      "enum": [
        "http",
        "response",
        "database",
        "callback",
        "bundle",
        "custom"
      ],
      "description": "Functional family that the checker belongs to."
    },
    "type": {
      "type": "string",
      "enum": [
        "builtin",
        "custom"
      ],
      "description": "Whether the checker is a built-in or extension checker."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "default": 100
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "supportedCheckNodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Checker keys accepted in testcase check definitions."
    },
    "supportedAssertionFormats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": [],
      "description": "Assertion formats consumed by the checker, such as inline map or preset file reference."
    },
    "executionScope": {
      "type": "string",
      "enum": [
        "request",
        "response",
        "database",
        "callback",
        "bundle",
        "generic"
      ],
      "default": "generic"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registerHook": {
          "type": "string",
          "minLength": 1,
          "description": "Optional hook or bootstrap method used to register the checker."
        },
        "discoverable": {
          "type": "boolean",
          "default": true
        },
        "matchStrategy": {
          "type": "string",
          "enum": [
            "exact",
            "alias",
            "pattern",
            "hybrid"
          ],
          "default": "hybrid"
        }
      }
    }
  },
  "additionalProperties": false
}
